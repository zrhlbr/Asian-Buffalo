# XI GAME Production ENV — copy to /home/zrh-admin/xigame-prod/env/production.env
# chmod 600. NEVER commit real secrets.

NODE_ENV=production
PORT=8788
HOSTNAME=0.0.0.0

# Independent SQLite file (Docker volume /data)
AB_SQLITE_PATH=/data/xigame.sqlite

# Identity / money gates — MUST remain fail-closed on public Production
AB_FORCE_FAIL_CLOSED_IDENTITY=1
# Do NOT set:
# AB_ALLOW_TEST_IDENTITY
# AB_AUTH_OTP_TEST_MODE
# AB_TEST_PLAYER_ID

# Admin first-boot only (random strong secret). Remove after first login + password change.
AB_ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_TO_RANDOM_64_CHARS

# Optional live OTP later (currently stubs refuse live send)
# AB_SK_SMS_ENDPOINT=
# AB_SK_SMS_API_KEY=
# AB_SMTP_HOST=
# AB_SMTP_USER=
# AB_SMTP_PASS=
