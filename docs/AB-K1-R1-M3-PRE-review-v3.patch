+    roomBase: 50,
+    betLevel: 1,
+    betMultiplier: 1,
+    idempotencyKey: "round-get",
+  });
+  const spinBody = await parseJson(spinResponse);
+  const getResponse = await handleGetRound(db, makeAuth(), spinBody.roundId);
+  assert.equal(getResponse.status, 200);
