+  }
+}
+
+export type SpinFaultHooks = {
+  afterOutcomePersist?: () => Promise<void> | void;
+  afterWallet?: () => Promise<void> | void;
+  afterFreeGameAward?: () => Promise<void> | void;
+  beforeRoundStoreSave?: () => Promise<void> | void;
