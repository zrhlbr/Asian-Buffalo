+  g.strokeStyle = "#2b1603";
+  g.lineWidth = 7; g.lineCap = "round";
+  for (const [x1, y1, x2, y2] of [[-30, -46, -18, -30], [30, -46, 18, -30], [0, -52, 0, -34], [-56, -8, -38, 0], [56, -8, 38, 0]] as const) {
+    g.beginPath(); g.moveTo(x1, y1); g.lineTo(x2, y2); g.stroke();
