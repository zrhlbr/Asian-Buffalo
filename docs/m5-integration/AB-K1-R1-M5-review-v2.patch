+  color: #fff3c4; text-shadow: 0 0 22px rgba(249,224,138,.8);
+}
+
+/* ---------- jackpot ---------- */
+#jackpot-banner {
+  position: absolute; inset: 0; display: flex; flex-direction: column;
+  align-items: center; justify-content: center; gap: 8px; z-index: 40; pointer-events: none;
+  background: radial-gradient(ellipse at center, rgba(20,12,2,.35), rgba(10,6,1,.75));
+}
+.jackpot-rays {
+  position: absolute; width: 140vmax; height: 140vmax; border-radius: 50%;
+  background: conic-gradient(from 0deg,
+    rgba(249,224,138,.0) 0deg, rgba(249,224,138,.16) 10deg, rgba(249,224,138,0) 20deg,
+    rgba(249,224,138,.14) 30deg, rgba(249,224,138,0) 40deg, rgba(249,224,138,.16) 50deg,
+    rgba(249,224,138,0) 60deg, rgba(249,224,138,.14) 70deg, rgba(249,224,138,0) 80deg,
+    rgba(249,224,138,.16) 90deg, rgba(249,224,138,0) 100deg, rgba(249,224,138,.14) 110deg,
+    rgba(249,224,138,0) 120deg, rgba(249,224,138,.16) 130deg, rgba(249,224,138,0) 140deg,
+    rgba(249,224,138,.14) 150deg, rgba(249,224,138,0) 160deg, rgba(249,224,138,.16) 170deg,
+    rgba(249,224,138,0) 180deg, rgba(249,224,138,.14) 190deg, rgba(249,224,138,0) 200deg,
+    rgba(249,224,138,.16) 210deg, rgba(249,224,138,0) 220deg, rgba(249,224,138,.14) 230deg,
+    rgba(249,224,138,0) 240deg, rgba(249,224,138,.16) 250deg, rgba(249,224,138,0) 260deg,
+    rgba(249,224,138,.14) 270deg, rgba(249,224,138,0) 280deg, rgba(249,224,138,.16) 290deg,
+    rgba(249,224,138,0) 300deg, rgba(249,224,138,.14) 310deg, rgba(249,224,138,0) 320deg,
+    rgba(249,224,138,.16) 330deg, rgba(249,224,138,0) 340deg, rgba(249,224,138,.14) 350deg);
+  animation: raysSpin 14s linear infinite;
+}
+@keyframes raysSpin { to { transform: rotate(360deg); } }
+.jackpot-text {
+  position: relative; font-size: clamp(48px, 10vw, 120px); font-weight: 900; letter-spacing: 10px;
+  background: linear-gradient(180deg, #fffbe0, var(--gold-1) 45%, var(--gold-3));
+  -webkit-background-clip: text; background-clip: text; color: transparent;
+  filter: drop-shadow(0 6px 26px rgba(249,224,138,.8));
+  animation: tierIn .6s cubic-bezier(.2,1.6,.4,1) both;
+}
+#jackpot-amount {
+  position: relative; font-size: clamp(28px, 5vw, 56px); font-weight: 800;
+  color: #fff3c4; text-shadow: 0 0 26px rgba(249,224,138,.9);
+}
+
+/* ---------- toast ---------- */
+#toast {
+  position: absolute; top: 72px; left: 50%; transform: translateX(-50%);
+  padding: 10px 22px; border-radius: 999px; z-index: 25;
+  border: 1px solid var(--panel-line);
+  background: rgba(20,14,5,.92); color: var(--gold-1);
+  font-size: 15px; letter-spacing: 1px;
+  box-shadow: 0 6px 24px rgba(0,0,0,.5);
+  animation: toastIn .3s ease both;
+}
+@keyframes toastIn { from { transform: translate(-50%, -14px); opacity: 0; } }
+
+/* ---------- modal ---------- */
+.modal {
+  position: absolute; inset: 0; z-index: 50;
+  display: flex; align-items: center; justify-content: center;
+  background: rgba(8,5,1,.7); backdrop-filter: blur(4px);
+}
+.modal-card {
+  width: min(680px, 92vw); max-height: 82vh; overflow: hidden;
+  border-radius: 18px; border: 1px solid var(--panel-line);
+  background: linear-gradient(180deg, rgba(36,26,11,.97), rgba(16,11,4,.97));
+  box-shadow: 0 24px 80px rgba(0,0,0,.7);
+  display: flex; flex-direction: column;
+  animation: modalIn .28s cubic-bezier(.2,1.4,.4,1) both;
+}
+@keyframes modalIn { from { transform: translateY(26px) scale(.96); opacity: 0; } }
+.modal-head {
+  display: flex; align-items: center; justify-content: space-between;
+  padding: 14px 18px; font-size: 18px; font-weight: 800; letter-spacing: 2px;
+  color: var(--gold-1); border-bottom: 1px solid rgba(212,175,55,.25);
+}
+.modal-body { padding: 16px 18px; overflow-y: auto; font-size: 14px; line-height: 1.75; }
+.pay-row { display: flex; align-items: center; gap: 12px; padding: 6px 4px; border-bottom: 1px dashed rgba(212,175,55,.15); }
+.pay-row img, .pay-row canvas { width: 44px; height: 44px; border-radius: 8px; }
+.pay-row .pay-name { flex: 1; font-weight: 700; }
+.pay-row .pay-vals { color: #e8d49a; font-variant-numeric: tabular-nums; white-space: nowrap; }
+.pay-note { margin-top: 12px; color: #b49b5e; font-size: 13px; }
+
+/* ---------- loading ---------- */
+#loading {
+  position: absolute; inset: 0; z-index: 100;
+  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 22px;
+  background: radial-gradient(ellipse at center, #241a0b, #0d0903);
+  transition: opacity .6s ease;
+}
+#loading.done { opacity: 0; pointer-events: none; }
+.loading-emblem {
+  width: 84px; height: 84px; border-radius: 50%;
+  border: 3px solid var(--gold-2); border-top-color: transparent;
+  animation: ringSpin 1s linear infinite;
+  box-shadow: 0 0 30px rgba(212,175,55,.4), inset 0 0 20px rgba(212,175,55,.25);
+}
+#loading-text { letter-spacing: 4px; color: var(--gold-1); font-size: 15px; }
+
+/* ---------- responsive ---------- */
+@media (max-width: 760px) {
+  #logo-text { font-size: 16px; letter-spacing: 1px; }
