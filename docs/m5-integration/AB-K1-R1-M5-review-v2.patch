+.fs-star { color: var(--gold-1); animation: spinStar 2.2s linear infinite; display: inline-block; }
+@keyframes spinStar { to { transform: rotate(360deg); } }
+@keyframes fsGlow { 50% { box-shadow: 0 0 30px rgba(249,224,138,.6), inset 0 1px 0 rgba(249,224,138,.35); } }
