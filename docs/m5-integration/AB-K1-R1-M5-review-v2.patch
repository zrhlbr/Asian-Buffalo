+}
+.icon-btn:hover { box-shadow: 0 0 12px rgba(212,175,55,.55); transform: translateY(-1px); }
+.icon-btn.off { color: #8a7a55; text-decoration: line-through; }
+
+#lang-switch {
+  display: flex; border: 1px solid var(--panel-line); border-radius: 10px; overflow: hidden;
