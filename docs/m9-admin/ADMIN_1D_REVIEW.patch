+export async function getGameOps(db: AdminDb, gameId: string) {
+  if (gameId !== OFFICIAL_GAME.id && gameId !== OFFICIAL_GAME.code) {
+    return null;
+  }
+  const runtime = await resolveGameRuntimeStatus(db);
