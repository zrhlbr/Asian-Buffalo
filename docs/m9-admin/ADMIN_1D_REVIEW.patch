+
+/** Single official title constant 鈥?shared by Games / Round / Spin read models. */
+const OFFICIAL_GAME = {
+  id: "bull-demon-king",
+  code: "bull-demon-king",
+  nameZh: "鐗涢瓟鐜?,
+  nameEn: "Bull Demon King",
