+        <span className="ab-chip">{t("activities.noAdminCredit")}</span>
+      </div>
+      {error ? <ErrorBox message={error} /> : null}
+
+      {canManage ? (
+        <div className="ab-card" style={{ marginBottom: 12, display: "grid", gap: 8, maxWidth: 560 }}>
