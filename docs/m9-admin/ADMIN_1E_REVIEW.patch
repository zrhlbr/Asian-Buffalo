+export type LedgerListQuery = PageQuery & {
+  playerId?: string;
+  currency?: string;
+  direction?: "DEBIT" | "CREDIT";
+  roundId?: string;
+  spinId?: string;
+  referenceId?: string;
+  depositOrderId?: string;
+  withdrawalOrderId?: string;
+  dateFrom?: string;
+  dateTo?: string;
