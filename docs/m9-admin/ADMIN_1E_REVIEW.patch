+const HIGH_RISK_AUDIT_ACTIONS = [
+  "player.freeze",
+  "player.unfreeze",
+  "player.ban",
+  "session.revoke",
+  "deposit.confirm",
+  "withdraw.approve",
+  "withdraw.reject",
