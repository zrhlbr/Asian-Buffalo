new file mode 100644
index 0000000..77c822d
--- /dev/null
+++ b/app/admin/admin-app.tsx
@@ -0,0 +1,351 @@
+"use client";
+
+/**
+ * R1-M9 Admin console 鈥?application shell: login gate, sidebar navigation,
+ * top bar (language switch / admin chip / logout), multi-tab strip and the
+ * module switchboard. Phase A preserved; Phase B鈥揊 modules added additively.
+ */
+
+import React, { useState } from "react";
+import { AdminProvider, useAdmin } from "./admin-ui.tsx";
+import type { AdminI18nKey } from "../../lib/admin/i18n.ts";
+import { ADMIN_LOCALES } from "../../lib/admin/i18n.ts";
+import DashboardModule from "./modules/dashboard.tsx";
+import PlayersModule from "./modules/players.tsx";
+import SessionsModule from "./modules/sessions.tsx";
+import RoundsModule from "./modules/rounds.tsx";
+import SpinsModule from "./modules/spins.tsx";
+import WalletModule from "./modules/wallet.tsx";
+import LedgerModule from "./modules/ledger.tsx";
+import MathModule from "./modules/math.tsx";
+import RiskModule from "./modules/risk.tsx";
+import ReportsModule from "./modules/reports.tsx";
+import SystemModule from "./modules/system.tsx";
+import AdminsModule from "./modules/admins.tsx";
+import VipModule from "./modules/vip.tsx";
+import DepositsModule from "./modules/deposits.tsx";
+import WithdrawalsModule from "./modules/withdrawals.tsx";
+import ActivitiesModule from "./modules/activities.tsx";
+import GamesModule from "./modules/games.tsx";
+import GameOpsModule from "./modules/game-ops.tsx";
+import AnnouncementsModule from "./modules/announcements.tsx";
+import ContentModule from "./modules/content.tsx";
+import RankingsModule from "./modules/rankings.tsx";
+import SupportModule from "./modules/support.tsx";
+import TicketsModule from "./modules/tickets.tsx";
+import SecurityModule from "./modules/security.tsx";
+import AuditModule from "./modules/audit.tsx";
+
+type NavItem = {
+  key: string;
+  titleKey: AdminI18nKey;
+  icon: string;
+  permission?: string;
+};
+
+const NAV: { group: AdminI18nKey; items: NavItem[] }[] = [
+  {
+    group: "nav.group.operations",
+    items: [
+      { key: "dashboard", titleKey: "nav.dashboard", icon: "鈼?, permission: "dashboard:view" },
+      { key: "players", titleKey: "nav.players", icon: "馃懁", permission: "players:view" },
+      { key: "vip", titleKey: "nav.vip", icon: "鈾?, permission: "vip:view" },
+      { key: "activities", titleKey: "nav.activities", icon: "馃巵", permission: "activity:view" },
+      { key: "sessions", titleKey: "nav.sessions", icon: "鈼?, permission: "rounds:view" },
+      { key: "rounds", titleKey: "nav.rounds", icon: "馃幇", permission: "rounds:view" },
+      { key: "spins", titleKey: "nav.spins", icon: "鈫?, permission: "rounds:view" },
+      { key: "games", titleKey: "nav.games", icon: "馃幃", permission: "rounds:view" },
+      { key: "gameOps", titleKey: "nav.gameOps", icon: "馃悆", permission: "rounds:view" },
+      { key: "risk", titleKey: "nav.risk", icon: "馃洝", permission: "risk:view" },
+      { key: "reports", titleKey: "nav.reports", icon: "鈻?, permission: "dashboard:view" },
+      { key: "rankings", titleKey: "nav.rankings", icon: "馃弳", permission: "dashboard:view" },
+    ],
+  },
+  {
+    group: "nav.group.finance",
+    items: [
+      { key: "wallet", titleKey: "nav.wallet", icon: "馃捈", permission: "wallet:view" },
+      { key: "deposits", titleKey: "nav.deposits", icon: "鈫?, permission: "deposit:view" },
+      { key: "withdrawals", titleKey: "nav.withdrawals", icon: "鈫?, permission: "withdraw:view" },
+      { key: "ledger", titleKey: "nav.ledger", icon: "馃搾", permission: "ledger:view" },
+    ],
+  },
+  {
+    group: "nav.group.platform",
+    items: [
+      { key: "math", titleKey: "nav.math", icon: "鈭?, permission: "math:view" },
+      { key: "content", titleKey: "nav.content", icon: "馃摪", permission: "content:view" },
+      { key: "announcements", titleKey: "nav.announcements", icon: "馃摙", permission: "content:view" },
+      { key: "tickets", titleKey: "nav.tickets", icon: "馃帿", permission: "support:view" },
+      { key: "support", titleKey: "nav.support", icon: "鈽?, permission: "system:view" },
+      { key: "system", titleKey: "nav.system", icon: "鈿?, permission: "system:view" },
+      { key: "security", titleKey: "nav.security", icon: "馃攼", permission: "security:view" },
+      { key: "audit", titleKey: "nav.audit", icon: "馃搵", permission: "logs:view" },
+      { key: "admins", titleKey: "nav.admins", icon: "馃棟", permission: "admins:view" },
+    ],
+  },
+];
+
+function LoginScreen() {
+  const { t, login } = useAdmin();
+  const [username, setUsername] = useState("");
+  const [password, setPassword] = useState("");
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+
+  const submit = async () => {
+    setBusy(true);
+    setError(null);
+    const result = await login(username.trim(), password);
+    setBusy(false);
+    if (!result.ok) {
+      setError(result.error === "ACCOUNT_DISABLED" ? t("login.accountDisabled") : t("login.failed"));
+    }
+  };
+
+  return (
+    <div className="ab-login-wrap">
+      <div className="ab-login-card">
+        <div className="ab-login-logo">馃悆</div>
+        <div className="ab-login-title">{t("login.title")}</div>
+        <div className="ab-login-sub">{t("login.subtitle")}</div>
+        {error ? <div className="ab-login-error">{error}</div> : null}
+        <div className="ab-field">
+          <label>{t("login.username")}</label>
+          <input
+            className="ab-input"
+            value={username}
+            autoComplete="username"
+            onChange={(event) => setUsername(event.target.value)}
+            onKeyDown={(event) => event.key === "Enter" && submit()}
+          />
+        </div>
+        <div className="ab-field">
+          <label>{t("login.password")}</label>
+          <input
+            className="ab-input"
+            type="password"
+            value={password}
+            autoComplete="current-password"
+            onChange={(event) => setPassword(event.target.value)}
+            onKeyDown={(event) => event.key === "Enter" && submit()}
+          />
+        </div>
+        <button
+          className="ab-btn primary"
+          style={{ width: "100%", justifyContent: "center", marginTop: 6 }}
+          disabled={busy || !username || !password}
+          onClick={submit}
+        >
+          {t("login.submit")}
+        </button>
+      </div>
+    </div>
+  );
+}
+
+const MODULE_TITLES: Record<string, AdminI18nKey> = {
+  dashboard: "nav.dashboard",
+  players: "nav.players",
+  vip: "nav.vip",
+  activities: "nav.activities",
+  sessions: "nav.sessions",
+  rounds: "nav.rounds",
+  spins: "nav.spins",
+  games: "nav.games",
+  gameOps: "nav.gameOps",
+  wallet: "nav.wallet",
+  deposits: "nav.deposits",
+  withdrawals: "nav.withdrawals",
+  ledger: "nav.ledger",
+  math: "nav.math",
+  risk: "nav.risk",
+  reports: "nav.reports",
+  rankings: "nav.rankings",
+  content: "nav.content",
+  announcements: "nav.announcements",
+  tickets: "nav.tickets",
+  support: "nav.support",
+  system: "nav.system",
+  security: "nav.security",
+  audit: "nav.audit",
+  admins: "nav.admins",
+};
+
+function ModuleView({
+  tabKey,
+  initialProps,
+}: {
+  tabKey: string;
+  initialProps?: Record<string, string>;
+}) {
+  const module = tabKey.split(":")[0];
+  switch (module) {
+    case "dashboard":
+      return <DashboardModule />;
+    case "players":
+      return <PlayersModule initialProps={initialProps} />;
+    case "vip":
+      return <VipModule />;
+    case "activities":
+      return <ActivitiesModule />;
+    case "sessions":
+      return <SessionsModule initialProps={initialProps} />;
+    case "rounds":
+      return <RoundsModule initialProps={initialProps} />;
+    case "spins":
+      return <SpinsModule initialProps={initialProps} />;
+    case "games":
+      return <GamesModule />;
+    case "gameOps":
+      return <GameOpsModule initialProps={initialProps} />;
+    case "wallet":
+      return <WalletModule initialProps={initialProps} />;
+    case "deposits":
+      return <DepositsModule />;
+    case "withdrawals":
+      return <WithdrawalsModule />;
+    case "ledger":
+      return <LedgerModule initialProps={initialProps} />;
+    case "math":
+      return <MathModule />;
+    case "risk":
+      return <RiskModule initialProps={initialProps} />;
+    case "reports":
+      return <ReportsModule />;
+    case "rankings":
+      return <RankingsModule />;
+    case "content":
+      return <ContentModule />;
+    case "announcements":
+      return <AnnouncementsModule />;
+    case "tickets":
+      return <TicketsModule />;
+    case "support":
+      return <SupportModule />;
+    case "system":
+      return <SystemModule />;
+    case "security":
+      return <SecurityModule />;
+    case "audit":
+      return <AuditModule />;
+    case "admins":
+      return <AdminsModule />;
+    default:
+      return <DashboardModule />;
+  }
+}
+
+function Shell() {
+  const { t, me, token, authReady, locale, setLocale, logout, tabs, activeTab, openTab, closeTab, can } =
+    useAdmin();
+
+  if (!authReady) return <div className="ab-loading">{t("common.loading")}</div>;
+  if (!token || !me) return <LoginScreen />;
+
+  const activeTabDef = tabs.find((tab) => tab.key === activeTab);
+
+  return (
+    <div className="ab-shell">
+      <aside className="ab-sidebar">
+        <div className="ab-brand">
+          <div className="ab-brand-title">馃悆 {t("common.appName")}</div>
+          <div className="ab-brand-sub">XI GAME ADMIN</div>
+        </div>
+        <nav className="ab-nav">
+          {NAV.map((group) => {
+            const visible = group.items.filter((item) => !item.permission || can(item.permission));
+            if (visible.length === 0) return null;
+            return (
+              <div key={group.group}>
+                <div className="ab-nav-group">{t(group.group)}</div>
+                {visible.map((item) => (
+                  <button
+                    key={item.key}
+                    className={`ab-nav-item${activeTab === item.key ? " active" : ""}`}
+                    onClick={() => openTab({ key: item.key, titleKey: item.titleKey })}
+                  >
+                    <span className="ab-nav-icon" aria-hidden>
+                      {item.icon}
+                    </span>
+                    <span>{t(item.titleKey)}</span>
+                  </button>
+                ))}
+              </div>
+            );
+          })}
+        </nav>
+      </aside>
+
+      <div className="ab-main">
+        <header className="ab-topbar">
+          <div className="ab-topbar-title">
+            {t(MODULE_TITLES[activeTab.split(":")[0]] ?? "nav.dashboard")}
+          </div>
+          <div className="ab-money-gate-chip" title="PRODUCTION MONEY GATE CLOSED">
+            <span>{t("money.realProvider" as never)}: {t("money.notConfigured" as never)}</span>
+            <span>{t("money.productionMoney" as never)}: {t("money.gateClosed" as never)}</span>
+          </div>
+          <div className="ab-chip">
+            馃棟 <b>{me.username}</b> 路 {me.role}
+          </div>
+          <div className="ab-lang">
+            {ADMIN_LOCALES.map((item) => (
+              <button
+                key={item}
+                className={locale === item ? "active" : undefined}
+                onClick={() => setLocale(item)}
+              >
+                {item === "zh" ? "涓枃" : item === "en" ? "EN" : "醼欋€坚€斸€横€欋€?}
+              </button>
+            ))}
+          </div>
+          <button className="ab-btn" onClick={logout}>
+            {t("common.logout")}
+          </button>
+        </header>
+
+        <div className="ab-tabs">
+          {tabs.map((tab) => (
+            <div
+              key={tab.key}
+              className={`ab-tab${activeTab === tab.key ? " active" : ""}`}
+              onClick={() => openTab(tab)}
+            >
+              {t(tab.titleKey)}
+              {tabs.length > 1 ? (
+                <button
+                  className="ab-tab-close"
+                  onClick={(event) => {
+                    event.stopPropagation();
+                    closeTab(tab.key);
+                  }}
+                >
+                  脳
+                </button>
+              ) : null}
+            </div>
+          ))}
+        </div>
+
+        <main className="ab-content">
+          {tabs.map((tab) =>
+            tab.key === activeTab ? (
+              <div key={tab.key}>
+                <ModuleView tabKey={tab.key} initialProps={activeTabDef?.props ?? tab.props} />
+              </div>
+            ) : null,
+          )}
+        </main>
+      </div>
+    </div>
+  );
+}
+
+export default function AdminApp() {
+  return (
+    <AdminProvider>
+      <Shell />
+    </AdminProvider>
+  );
+}
diff --git a/app/admin/modules/admins.tsx b/app/admin/modules/admins.tsx
new file mode 100644
index 0000000..55bfb2f
--- /dev/null
+++ b/app/admin/modules/admins.tsx
@@ -0,0 +1,402 @@
+"use client";
+
+/** R1-M7 鈥?Admins: list + create + role/status/password (audited mutations). */
+
+import React, { useCallback, useEffect, useState } from "react";
+import {
+  Badge,
+  DangerConfirm,
+  DataTable,
+  ErrorBox,
+  Loading,
+  StatCard,
+  fmtTime,
+  useAdmin,
+  type ColumnDef,
+} from "../admin-ui.tsx";
+
+type AdminRow = {
+  id: string;
+  username: string;
+  role: string;
+  status: string;
+  last_login_at: string | null;
+  created_at: string;
+  op_count?: number;
+  risk_op_count?: number;
+  last_login_ip?: string | null;
+  [key: string]: unknown;
+};
+
+type AdminStats = {
+  active: number;
+  disabled: number;
+  total: number;
+  byRole: Record<string, number>;
+  auditTotal: number;
+  riskOpTotal: number;
+};
+
+type MatrixPayload = {
+  permissions: string[];
+  dangerous: string[];
+  roles: { role: string; grants: string[] }[];
+};
+
+const ROLES = [
+  "SUPER_ADMIN",
+  "OPS",
+  "SUPPORT",
+  "FINANCE",
+  "RISK",
+  "AUDIT",
+  "TECH",
+  "READONLY",
+] as const;
+
+export default function AdminsModule() {
+  const { t, api, toast, me } = useAdmin();
+  const [items, setItems] = useState<AdminRow[] | null>(null);
+  const [stats, setStats] = useState<AdminStats | null>(null);
+  const [matrix, setMatrix] = useState<MatrixPayload | null>(null);
+  const [auditFor, setAuditFor] = useState<{ id: string; items: Record<string, unknown>[] } | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [confirm, setConfirm] = useState<
+    | { kind: "disable" | "enable"; id: string }
+    | { kind: "change_role"; id: string; role: string }
+    | { kind: "reset_password"; id: string; password: string }
+    | { kind: "create" }
+    | null
+  >(null);
+  const [newUser, setNewUser] = useState("");
+  const [newPass, setNewPass] = useState("");
+  const [newRole, setNewRole] = useState<string>("OPS");
+  const [rolePick, setRolePick] = useState("OPS");
+  const [matrixOpen, setMatrixOpen] = useState<string | null>(null);
+  const [passPick, setPassPick] = useState("");
+  const [pendingId, setPendingId] = useState<string | null>(null);
+
+  const load = useCallback(async () => {
+    try {
+      const [result, statsResult, matrixResult] = await Promise.all([
+        api<{ items: AdminRow[] }>("admins"),
+        api<AdminStats>("admins/stats"),
+        api<MatrixPayload>("admins/matrix"),
+      ]);
+      setItems(result.items);
+      setStats(statsResult);
+      setMatrix(matrixResult);
+      setError(null);
+    } catch (cause) {
+      setError(cause instanceof Error ? cause.message : String(cause));
+    }
+  }, [api]);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  const runConfirm = async (reason: string) => {
+    if (!confirm) return;
+    setBusy(true);
+    try {
+      if (confirm.kind === "create") {
+        await api("admins", {
+          method: "POST",
+          body: { username: newUser, password: newPass, role: newRole, reason },
+        });
+        setNewUser("");
+        setNewPass("");
+      } else if (confirm.kind === "disable" || confirm.kind === "enable") {
+        await api(`admins/${encodeURIComponent(confirm.id)}`, {
+          method: "POST",
+          body: { action: confirm.kind, reason },
+        });
+      } else if (confirm.kind === "change_role") {
+        await api(`admins/${encodeURIComponent(confirm.id)}`, {
+          method: "POST",
+          body: { action: "change_role", role: confirm.role, reason },
+        });
+      } else {
+        await api(`admins/${encodeURIComponent(confirm.id)}`, {
+          method: "POST",
+          body: { action: "reset_password", password: confirm.password, reason },
+        });
+      }
+      toast(t("common.success"));
+      setConfirm(null);
+      setPendingId(null);
+      await load();
+    } catch (cause) {
+      toast(cause instanceof Error ? cause.message : String(cause), true);
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  const columns: ColumnDef<AdminRow>[] = [
+    { key: "username", title: t("login.username"), render: (row) => <b>{row.username}</b> },
+    { key: "role", title: t("admins.role"), render: (row) => <Badge tone="purple">{row.role}</Badge> },
+    {
+      key: "status",
+      title: t("common.status"),
+      render: (row) => (
+        <Badge tone={row.status === "ACTIVE" ? "green" : "red"}>
+          {row.status === "ACTIVE" ? t("admins.enabled") : t("admins.disabled")}
+        </Badge>
+      ),
+    },
+    {
+      key: "op_count",
+      title: t("admins.opCount"),
+      render: (row) => String(row.op_count ?? 0),
+    },
+    {
+      key: "risk_op_count",
+      title: t("admins.riskOpCount"),
+      render: (row) => String(row.risk_op_count ?? 0),
+    },
+    {
+      key: "last_login_at",
+      title: t("admins.lastLoginAt"),
+      render: (row) => (row.last_login_at ? fmtTime(row.last_login_at) : "-"),
+    },
+    { key: "created_at", title: t("common.createdAt"), render: (row) => fmtTime(row.created_at) },
+    {
+      key: "actions",
+      title: t("common.actions"),
+      render: (row) => {
+        const self = me?.id === row.id;
+        return (
+          <div style={{ display: "flex", gap: 6, flexWrap: "wrap" }}>
+            <button
+              className="ab-btn"
+              onClick={() =>
+                void api<{ items: Record<string, unknown>[] }>(`admins/${encodeURIComponent(row.id)}/audit`)
+                  .then((res) => setAuditFor({ id: row.id, items: res.items }))
+                  .catch(() => undefined)
+              }
+            >
+              {t("admins.recentAudit")}
+            </button>
+            <button
+              className="ab-btn"
+              disabled={self}
+              onClick={() => setConfirm({ kind: row.status === "ACTIVE" ? "disable" : "enable", id: row.id })}
+            >
+              {row.status === "ACTIVE" ? t("admins.disable") : t("admins.enable")}
+            </button>
+            <button
+              className="ab-btn"
+              disabled={self}
+              onClick={() => {
+                setPendingId(row.id);
+                setRolePick(row.role);
+              }}
+            >
+              {t("admins.changeRole")}
+            </button>
+            <button
+              className="ab-btn"
+              onClick={() => {
+                setPendingId(row.id);
+                setPassPick("");
+              }}
+            >
+              {t("admins.resetPassword")}
+            </button>
+          </div>
+        );
+      },
+    },
+  ];
+
+  if (error && !items) return <ErrorBox message={error} />;
+  if (!items) return <Loading text={t("common.loading")} />;
+
+  return (
+    <div>
+      <div className="ab-chip" style={{ marginBottom: 12 }}>
+        {t("admins.auditHint")}
+      </div>
+
+      {stats ? (
+        <div className="ab-stat-grid" style={{ marginBottom: 16 }}>
+          <StatCard label={t("admins.stats")} value={String(stats.total)} />
+          <StatCard label={t("admins.activeCount")} value={String(stats.active)} tone="ok" />
+          <StatCard label={t("admins.disabledCount")} value={String(stats.disabled)} />
+          <StatCard label={t("admins.opCount")} value={String(stats.auditTotal)} />
+          <StatCard label={t("admins.riskOpCount")} value={String(stats.riskOpTotal)} tone={stats.riskOpTotal > 0 ? "bad" : "ok"} />
+        </div>
+      ) : null}
+
+      {matrix ? (
+        <div className="ab-panel" style={{ marginBottom: 16 }}>
+          <div className="ab-panel-title">{t("admins.matrix")}</div>
+          <div className="ab-chip" style={{ marginBottom: 8 }}>
+            {(matrix as { note?: string }).note ?? "STATIC_MAP 路 read-only"}
+          </div>
+          <div className="ab-table-wrap" style={{ marginBottom: 10 }}>
+            <table className="ab-table">
+              <thead>
+                <tr>
+                  <th>{t("admins.role")}</th>
+                  <th>{t("common.total")}</th>
+                  <th>Dangerous</th>
+                </tr>
+              </thead>
+              <tbody>
+                {matrix.roles.map((row) => (
+                  <tr key={row.role}>
+                    <td><Badge tone="purple">{row.role}</Badge></td>
+                    <td>{row.grants.length}</td>
+                    <td>{row.grants.filter((g) => matrix.dangerous.includes(g)).join(", ") || "-"}</td>
+                  </tr>
+                ))}
+              </tbody>
+            </table>
+          </div>
+          {Object.entries((matrix as { modules?: Record<string, string[]> }).modules ?? {}).map(
+            ([mod, perms]) => (
+              <div key={mod} style={{ marginBottom: 6 }}>
+                <button
+                  className="ab-btn"
+                  style={{ width: "100%", justifyContent: "space-between" }}
+                  onClick={() => setMatrixOpen(matrixOpen === mod ? null : mod)}
+                >
+                  <span>{mod}</span>
+                  <span>{perms.length}</span>
