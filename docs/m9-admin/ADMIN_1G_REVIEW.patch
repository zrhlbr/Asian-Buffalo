+  "activity:view",
+];
+
+export const ROLE_PERMISSIONS: Record<AdminRole, readonly AdminPermission[] | "*"> = {
+  SUPER_ADMIN: "*",
+  OPS: [
+    "dashboard:view",
+    "players:view",
+    "players:freeze",
+    "players:sessions:view",
+    // OPS: sessions list OK; no full PII / raw IP-device by default (S-19).
+    "players:session:revoke",
+    "rounds:view",
+    "risk:view",
+    "system:view",
