+
+      <GameClient />
+
+      {confirmOpen ? (
+        <div
+          className="xi-play-leave-mask"
+          data-testid="xi-play-leave-confirm"
+          role="dialog"
+          aria-modal="true"
+          aria-labelledby="xi-play-leave-title"
