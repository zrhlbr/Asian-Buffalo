+            <p>
+              {waitingSafe
+                ? tLobby(lang, "lobby.play.leaveWaiting")
+                : tLobby(lang, "lobby.play.leaveBody")}
+            </p>
+            <div className="xi-play-leave-actions">
+              {!waitingSafe ? (
+                <>
+                  <button
+                    type="button"
+                    className="xi-play-leave-stay"
