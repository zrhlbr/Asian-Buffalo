+      config?: { presetsMinor?: number[] };
+      channels?: Array<{ code: string; title: Record<string, string>; currency: string }>;
+      readiness?: {
+        productionReady?: boolean;
+        code?: string;
+        reason?: string;
+        testHarnessAllowed?: boolean;
+      };
+      error?: { code?: string; message?: string };
