+  text-decoration: none;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+}
+
+.xi-primary {
+  border: 1px solid rgba(232, 197, 106, 0.55);
+  background: linear-gradient(180deg, #d9b056, #8f6418);
+  color: #1a1208;
+  font-weight: 700;
+}
+
+.xi-secondary {
+  border: 1px solid var(--xi-line);
+  background: rgba(255, 255, 255, 0.04);
+  color: var(--xi-mist);
+}
+
+.xi-panel-card {
+  border: 1px solid var(--xi-line);
+  border-radius: 0.85rem;
+  background: var(--xi-panel);
+  padding: 0.9rem;
+}
+
+.xi-status-line {
+  font-size: 0.78rem;
+  color: rgba(244, 231, 194, 0.65);
+}
+
+/* Cinematic pilgrim silhouette band 鈥?ASSET_GAP fallback (no Zhao still) */
+.xi-hero-pilgrims {
+  position: absolute;
+  left: 6%;
+  bottom: 18%;
+  width: 42%;
+  height: 22%;
+  pointer-events: none;
+  opacity: 0.42;
+  background:
+    radial-gradient(12% 55% at 12% 70%, rgba(20, 16, 12, 0.85), transparent 70%),
+    radial-gradient(10% 50% at 28% 72%, rgba(24, 18, 14, 0.8), transparent 70%),
+    radial-gradient(14% 65% at 48% 60%, rgba(18, 14, 12, 0.88), transparent 72%),
+    radial-gradient(9% 45% at 68% 74%, rgba(22, 16, 12, 0.75), transparent 70%),
+    radial-gradient(11% 58% at 86% 68%, rgba(16, 12, 10, 0.82), transparent 70%);
