+  color: #ffe7a4;
+}
+
+.xi-bdk-stub-tag {
+  margin: 0;
+  font-size: 0.78rem;
+  letter-spacing: 0.08em;
+  color: rgba(200, 220, 255, 0.75);
+}
+
+.xi-bdk-stub-card p {
+  margin: 0 0 1.1rem;
+  color: rgba(244, 231, 194, 0.78);
+  line-height: 1.45;
+  font-size: 0.92rem;
+}
+
+.xi-bdk-stub-back {
+  display: inline-flex !important;
+  min-width: 12rem;
+  text-decoration: none;
+}
+
+/* Step 4 — commerce panels (additive; no Step1/2 layout changes) */
+.xi-commerce-panel {
+  display: grid;
+  gap: 0.55rem;
+  text-align: left;
+}
+.xi-commerce-label {
+  display: grid;
+  gap: 0.25rem;
+  font-size: 0.85rem;
+  color: rgba(244, 231, 194, 0.85);
+}
+.xi-commerce-label input,
+.xi-commerce-label select {
+  width: 100%;
+  border-radius: 0.45rem;
+  border: 1px solid rgba(232, 197, 106, 0.35);
+  background: rgba(10, 12, 18, 0.75);
+  color: #f4e7c2;
+  padding: 0.45rem 0.55rem;
+}
+.xi-commerce-presets {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.4rem;
+}
