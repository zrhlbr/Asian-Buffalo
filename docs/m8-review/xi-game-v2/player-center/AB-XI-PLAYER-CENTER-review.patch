+
+/** Reference order: 充值/提现/活动中心/VIP中心/排行榜/公告/客服 */
+const QUICK_FEATURES: FeatureId[] = [
+  "recharge",
+  "withdraw",
+  "activity",
+  "vip",
+  "rankings",
+  "announcements",
