+  gap: 0.75rem;
+  margin: 0.75rem 0 1rem;
+  text-align: left;
+}
+.xi-quality-row {
+  display: flex;
+  flex-direction: column;
+  gap: 0.4rem;
+}
+.xi-quality-label {
+  font-size: 0.78rem;
+  letter-spacing: 0.04em;
+  color: rgba(240, 220, 160, 0.85);
+}
+.xi-quality-switch {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.35rem;
+}
+
+html[data-xi-tier="low"] .xi-hero-particles,
+html[data-xi-tier="low"] .xi-hero-cranes {
+  display: none !important;
+}
+html[data-xi-tier="medium"] .xi-hero-particles span:nth-child(n + 4),
+html[data-xi-tier="medium"] .xi-hero-cranes i:nth-child(n + 2) {
+  display: none;
+}
+/* LOW: Journey art kept; FX near-static */
+html[data-xi-tier="low"] .xi-hero-rays {
+  opacity: 0.18;
+  filter: none !important;
+  animation: none !important;
+}
+html[data-xi-tier="medium"] .xi-hero-rays {
+  opacity: 0.35;
+  filter: none !important;
+  animation: none !important;
+}
+html[data-xi-tier="low"] .xi-hero-clouds,
+html[data-xi-tier="low"] .xi-hero-mist {
+  animation: none !important;
+  filter: none !important;
+  opacity: 0.28;
+}
+html[data-xi-tier="medium"] .xi-hero-clouds,
+html[data-xi-tier="medium"] .xi-hero-mist {
+  animation: none !important;
+  filter: none !important;
+  opacity: 0.5;
+}
+html[data-xi-tier="low"] .xi-lobby-root,
+html[data-xi-tier="medium"] .xi-lobby-root,
+html[data-xi-tier="low"] .xi-topbar,
+html[data-xi-tier="medium"] .xi-topbar,
+html[data-xi-tier="low"] .xi-bottom-nav,
+html[data-xi-tier="medium"] .xi-bottom-nav,
+html[data-xi-tier="low"] .xi-modal-backdrop,
+html[data-xi-tier="medium"] .xi-modal-backdrop {
+  backdrop-filter: none !important;
+  -webkit-backdrop-filter: none !important;
+}
+html[data-xi-tier="low"] .xi-bdk-hero-embers,
+html[data-xi-tier="low"] .xi-bdk-hero-rays {
+  opacity: 0.25;
+  animation: none !important;
+  filter: none;
+}
+html[data-xi-tier="medium"] .xi-bdk-hero-embers {
+  opacity: 0.55;
+}
+html[data-xi-tier="high"] .xi-bdk-hero-embers,
+html[data-xi-tier="ultra"] .xi-bdk-hero-embers {
+  opacity: 1;
+}
+html[data-xi-fx="off"] .xi-hero-particles,
+html[data-xi-fx="off"] .xi-hero-rays,
+html[data-xi-fx="off"] .xi-bdk-hero-embers,
+html[data-xi-fx="off"] .xi-bdk-hero-rays {
+  display: none !important;
+}
+
+/* Ultra-narrow phones 320?360 */
+@media (max-width: 360px) {
+  .xi-topbar-v2 {
+    margin-inline: 0.3rem;
+    gap: 0.28rem;
+  }
+  .xi-lang-direct-btn {
+    font-size: 0.48rem;
+    padding: 0.14rem 0.2rem;
+  }
+  .xi-rec-card {
+    width: 5.9rem;
+    min-height: 8.4rem;
+  }
+  .xi-quick-btn {
+    font-size: 0.55rem;
+    height: 4.5rem;
+  }
+  .xi-bottom-nav-v2 .xi-nav-btn {
+    font-size: 0.58rem;
+    min-height: 44px;
+  }
+}
+
+html[data-xi-tier="low"] .xi-layout-v2,
+html[data-xi-tier="low"] .xi-modal,
+html[data-xi-tier="low"] .xi-decree-btn,
+html[data-xi-tier="low"] .xi-primary {
+  transition-duration: var(--xi-transition-ms, 220ms) !important;
+}
+
+/* ===== P3 Auth (mythic black-gold, mobile-first 320?C430) ===== */
+.xi-auth-entry {
+  display: flex;
+  gap: 0.28rem;
+  align-items: center;
+}
+.xi-auth-entry-btn {
+  border: 1px solid rgba(232, 197, 106, 0.45);
+  background: rgba(12, 16, 24, 0.72);
+  color: var(--xi-gold, #e8c56a);
+  border-radius: 999px;
+  padding: 0.22rem 0.55rem;
+  font-size: 0.62rem;
+  font-weight: 700;
+  letter-spacing: 0.02em;
+  cursor: pointer;
+  white-space: nowrap;
+}
+.xi-auth-entry-btn.is-primary {
+  background: linear-gradient(180deg, #d4a84b, #8a5a18);
+  color: #1a1208;
+  border-color: rgba(255, 220, 140, 0.65);
+}
+.xi-auth-root {
+  display: flex;
+  justify-content: center;
+  align-items: flex-start;
+  padding: 0.75rem 0.75rem 2rem;
+  min-height: 100dvh;
+}
+.xi-auth-shell {
+  width: min(100%, 26rem);
+  margin-top: 0.5rem;
+  padding: 1rem 1rem 1.25rem;
+  border-radius: 1rem;
+  border: 1px solid rgba(232, 197, 106, 0.38);
+  background:
+    radial-gradient(80% 60% at 50% 0%, rgba(232, 197, 106, 0.12), transparent 55%),
+    linear-gradient(180deg, rgba(22, 28, 40, 0.96), rgba(8, 10, 16, 0.98));
+  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
+}
+.xi-auth-header {
+  display: flex;
+  align-items: center;
+  gap: 0.65rem;
+  margin-bottom: 0.75rem;
+}
+.xi-auth-back {
+  width: 2rem;
+  height: 2rem;
+  border-radius: 999px;
+  border: 1px solid rgba(232, 197, 106, 0.35);
+  background: rgba(0, 0, 0, 0.25);
+  color: var(--xi-mist, #e8dcbd);
+  cursor: pointer;
+}
+.xi-auth-brand {
+  font-family: var(--xi-font-display);
+  font-size: 1.15rem;
+  color: var(--xi-gold, #e8c56a);
+  letter-spacing: 0.06em;
+}
+.xi-auth-title {
+  margin: 0 0 0.85rem;
+  font-family: var(--xi-font-display);
+  font-size: 1.35rem;
+  color: #f3e6c2;
+}
+.xi-auth-tabs {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 0.35rem;
+  margin-bottom: 0.85rem;
+}
+.xi-auth-tabs button {
+  border: 1px solid rgba(232, 197, 106, 0.28);
+  background: rgba(0, 0, 0, 0.28);
+  color: rgba(243, 230, 194, 0.75);
+  border-radius: 0.65rem;
+  padding: 0.55rem 0.4rem;
+  font-weight: 700;
+  cursor: pointer;
+}
+.xi-auth-tabs button.is-active {
+  color: #1a1208;
+  background: linear-gradient(180deg, #e0c06a, #a67c2d);
+  border-color: rgba(255, 230, 160, 0.7);
+}
+.xi-auth-steps {
+  display: flex;
+  gap: 0.35rem;
+  list-style: none;
+  padding: 0;
+  margin: 0 0 0.85rem;
+  font-size: 0.68rem;
+  color: rgba(243, 230, 194, 0.45);
+}
+.xi-auth-steps li {
+  flex: 1;
+  text-align: center;
+  padding: 0.3rem 0.2rem;
+  border-bottom: 2px solid rgba(232, 197, 106, 0.15);
+}
+.xi-auth-steps li.is-on {
+  color: var(--xi-gold, #e8c56a);
+  border-bottom-color: var(--xi-gold, #e8c56a);
+}
+.xi-auth-form {
+  display: flex;
+  flex-direction: column;
+  gap: 0.65rem;
+}
+.xi-auth-label {
+  display: flex;
+  flex-direction: column;
+  gap: 0.3rem;
+  font-size: 0.78rem;
+  color: rgba(243, 230, 194, 0.82);
+}
+.xi-auth-input {
+  border: 1px solid rgba(232, 197, 106, 0.32);
+  background: rgba(0, 0, 0, 0.35);
+  color: #f7efd8;
+  border-radius: 0.65rem;
+  padding: 0.7rem 0.75rem;
+  font-size: 1rem;
+  min-height: 2.75rem;
+}
+.xi-auth-input:focus {
+  outline: 1px solid rgba(232, 197, 106, 0.7);
+  border-color: rgba(232, 197, 106, 0.7);
+}
+.xi-auth-hint {
+  margin: 0;
+  font-size: 0.7rem;
+  color: rgba(243, 230, 194, 0.55);
+}
+.xi-auth-error {
+  margin: 0;
+  padding: 0.55rem 0.65rem;
+  border-radius: 0.55rem;
+  background: rgba(160, 40, 40, 0.28);
+  border: 1px solid rgba(220, 90, 80, 0.45);
+  color: #ffc9c2;
+  font-size: 0.78rem;
+}
+.xi-auth-info {
+  margin: 0;
+  font-size: 0.78rem;
+  color: #9fd9c2;
+}
+.xi-auth-cta {
+  margin-top: 0.35rem;
+  border: 0;
+  border-radius: 0.8rem;
+  min-height: 2.9rem;
+  font-size: 1rem;
+  font-weight: 800;
+  letter-spacing: 0.04em;
+  cursor: pointer;
+  color: #1a1208;
+  background: linear-gradient(180deg, #f0d078, #b8892d 55%, #8a5a18);
+  box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
+}
+.xi-auth-cta:disabled {
+  opacity: 0.55;
+  cursor: wait;
+}
+.xi-auth-links {
+  display: flex;
+  flex-direction: column;
+  gap: 0.45rem;
+  margin-top: 1rem;
+}
+.xi-auth-links button {
+  border: 0;
+  background: transparent;
+  color: rgba(232, 197, 106, 0.85);
+  font-size: 0.8rem;
+  text-decoration: underline;
+  cursor: pointer;
+  padding: 0.25rem;
+}
+@media (max-width: 430px) {
+  .xi-auth-shell {
+    margin-top: 0.25rem;
+    padding: 0.85rem 0.85rem 1.1rem;
+  }
+  .xi-auth-title {
+    font-size: 1.2rem;
+  }
+}
+@media (max-width: 360px) {
+  .xi-auth-entry-btn {
+    font-size: 0.55rem;
+    padding: 0.18rem 0.4rem;
+  }
+  .xi-auth-input {
+    font-size: 0.95rem;
+  }
+}
