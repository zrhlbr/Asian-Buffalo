+"use client";
+
+import Link from "next/link";
+import { useState } from "react";
+import {
+  loadLobbyLang,
+  tLobby,
+  type LobbyLang,
+} from "./i18n.ts";
+import "./lobby.css";
+
+/** Phase 1 stub hub 鈥?navigates to existing slot; does not mount reels. */
+export default function BdkHub() {
+  const [lang] = useState<LobbyLang>(() => loadLobbyLang());
+  const t = (key: string) => tLobby(lang, key);
+
+  return (
+    <div className="xi-lobby-root" data-testid="xi-bdk-hub" lang={lang}>
+      <div className="xi-bdk-hub">
+        <h1>{t("lobby.bdk.hubTitle")}</h1>
+        <p>{t("lobby.games.bdk.subtitle")}</p>
+        <p>{t("lobby.bdk.hubLead")}</p>
+        <div className="xi-bdk-actions">
+          <Link className="xi-primary" href="/game">
+            {t("lobby.bdk.openSlot")}
+          </Link>
+          <Link className="xi-secondary" href="/">
+            {t("lobby.play")} (/)
+          </Link>
+          <Link className="xi-secondary" href="/xi">
+            {t("lobby.bdk.backLobby")}
+          </Link>
+        </div>
+      </div>
+    </div>
+  );
+}
