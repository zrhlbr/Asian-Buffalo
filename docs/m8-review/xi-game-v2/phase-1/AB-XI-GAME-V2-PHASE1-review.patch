+export function loadLobbyLang(): LobbyLang {
+  if (typeof window === "undefined") return "zh-CN";
+  const raw = window.localStorage.getItem(LOBBY_LANG_STORAGE);
+  if (raw === "zh-CN" || raw === "en" || raw === "my-MM") return raw;
+  return "zh-CN";
+}
+
+export function saveLobbyLang(lang: LobbyLang): void {
+  if (typeof window === "undefined") return;
+  window.localStorage.setItem(LOBBY_LANG_STORAGE, lang);
+}
+
+export function tLobby(lang: LobbyLang, key: string): string {
+  return dict[lang][key] ?? dict.en[key] ?? key;
+}
+
+export function lobbyKeys(): string[] {
+  return Object.keys(dict["zh-CN"]).sort();
+}
+
+export function assertLobbyI18nComplete(): { ok: boolean; missing: string[] } {
+  const base = Object.keys(dict["zh-CN"]);
+  const missing: string[] = [];
+  for (const lang of LOBBY_LANGS) {
+    for (const key of base) {
+      if (!dict[lang][key]) missing.push(`${lang}:${key}`);
+    }
+  }
+  return { ok: missing.length === 0, missing };
+}
