+  .xi-bdk-hero-photo {
+    max-height: min(56vh, 32rem);
+  }
+}
+
+@media (max-width: 520px) {
+  .xi-bdk-hero-photo {
+    /* Phone: still contain full plate; taller band if needed */
+    max-height: min(48vh, 22rem);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .xi-bdk-hero-embers { animation: none; }
+}
diff --git a/client/xi-lobby/play-shell.tsx b/client/xi-lobby/play-shell.tsx
new file mode 100644
index 0000000..dda3889
