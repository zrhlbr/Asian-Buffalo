+  0% { transform: translate3d(0, 0, 0); }
+  100% { transform: translate3d(-8%, 0, 0); }
+}
+
+@keyframes xi-cloudsea {
+  0% { transform: translate3d(0, 0, 0); }
+  100% { transform: translate3d(-6%, -2%, 0); }
+}
+
+@keyframes xi-rays {
+  0% { transform: rotate(0deg); }
+  100% { transform: rotate(360deg); }
+}
+
+@keyframes xi-palace {
+  0%, 100% { opacity: 0.48; filter: drop-shadow(0 0 10px rgba(255, 210, 120, 0.28)); }
+  50% { opacity: 0.62; filter: drop-shadow(0 0 18px rgba(255, 220, 140, 0.45)); }
+}
+
+@keyframes xi-mist {
+  0%, 100% { opacity: 0.7; }
+  50% { opacity: 1; }
+}
+
+@keyframes xi-crane {
+  0% { transform: translate3d(0, 0, 0); opacity: 0; }
+  10% { opacity: 0.85; }
+  90% { opacity: 0.5; }
+  100% { transform: translate3d(55vw, -18%, 0); opacity: 0; }
+}
+
+@keyframes xi-sun {
+  0%, 100% { opacity: 0.75; transform: scale(1); }
+  50% { opacity: 1; transform: scale(1.06); }
+}
+
+@keyframes xi-particle {
+  0% { transform: translate3d(0, 110%, 0); opacity: 0; }
+  15% { opacity: 0.9; }
+  100% { transform: translate3d(12px, -20%, 0); opacity: 0; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .xi-hero-bg,
+  .xi-hero-clouds,
+  .xi-hero-cloudsea,
+  .xi-hero-rays,
+  .xi-hero-sun,
+  .xi-hero-palace,
+  .xi-hero-mist,
+  .xi-hero-cranes i,
+  .xi-hero-particles span {
+    animation: none;
+  }
+}
+
+.xi-main {
+  padding: 0.35rem 0.75rem 6.75rem;
+  display: flex;
+  flex-direction: column;
+  gap: 0.85rem;
+}
