+                <ActivityPanel t={t} lang={lang} onBalanceRefresh={refreshBalance} />
+              </>
+            )}
+            {modal === "checkin" && (
+              <>
+                <h2>{t("lobby.feat.checkin")}</h2>
+                <CheckinPanel t={t} onBalanceRefresh={refreshBalance} />
+              </>
+            )}
+            {modal === "rankings" && (
+              <>
+                <h2>{t("lobby.feat.rankings")}</h2>
+                <p>{t("lobby.pending.body")}</p>
+              </>
+            )}
