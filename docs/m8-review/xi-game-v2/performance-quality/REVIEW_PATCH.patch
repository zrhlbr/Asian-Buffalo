+                </div>
+              </>
+            )}
+            <div className="xi-modal-actions">
+              <button
+                type="button"
+                className="xi-secondary"
+                onClick={() => setModal(null)}
+              >
+                {t("lobby.close")}
+              </button>
+            </div>
+          </div>
+        </div>
+      )}
+    </div>
