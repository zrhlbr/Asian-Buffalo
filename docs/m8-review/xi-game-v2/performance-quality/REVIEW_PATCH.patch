+function shortPlayerId(raw: string | null | undefined): string {
+  if (!raw) return "鈥斺€斺€斺€?;
+  const digits = raw.replace(/\D/g, "");
+  if (digits.length >= 6) return digits.slice(-6);
+  if (raw.length >= 6) return raw.slice(-6);
+  return raw;
+}
