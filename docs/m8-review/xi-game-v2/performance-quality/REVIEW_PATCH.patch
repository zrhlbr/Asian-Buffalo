+}
+.xi-mythic-win .xi-win-cloud {
+  position: absolute;
+  left: -10%; right: -10%; top: 18%; height: 22%;
+  background:
+    radial-gradient(20% 60% at 30% 50%, rgba(255, 255, 255, 0.18), transparent 70%),
+    radial-gradient(24% 60% at 70% 50%, rgba(255, 230, 180, 0.16), transparent 70%);
+  animation: xi-win-cloud 1.8s ease-out both;
+  opacity: 0;
+}
+.xi-mythic-win .xi-win-lotus {
+  position: absolute;
+  left: 50%; top: 42%;
+  width: 64px; height: 64px;
+  transform: translate(-50%, -50%);
+  background: radial-gradient(circle, rgba(255, 200, 210, 0.35), transparent 65%);
+  clip-path: polygon(50% 8%, 62% 38%, 92% 42%, 70% 62%, 78% 92%, 50% 74%, 22% 92%, 30% 62%, 8% 42%, 38% 38%);
+  animation: xi-win-lotus 1.6s ease-out both;
+  opacity: 0;
+}
+.xi-mythic-win .xi-win-array {
+  position: absolute;
+  left: 50%; top: 48%;
+  width: min(70vw, 320px); height: min(70vw, 320px);
+  transform: translate(-50%, -50%);
+  border-radius: 50%;
+  border: 1px solid rgba(232, 197, 106, 0.25);
+  background: repeating-conic-gradient(from 0deg, rgba(255, 200, 100, 0.08) 0 3deg, transparent 3deg 28deg);
+  animation: xi-win-array 2.2s ease-out both;
+  opacity: 0;
+}
+.xi-mythic-win .xi-win-pillars {
+  position: absolute;
+  inset: 10% 18% 20%;
+  background:
+    linear-gradient(90deg, transparent, rgba(255, 220, 140, 0.12), transparent),
+    repeating-linear-gradient(90deg, transparent 0 18%, rgba(255, 220, 140, 0.1) 18% 20%, transparent 20% 38%);
+  mix-blend-mode: screen;
+  animation: xi-win-pillars 2s ease-out both;
+  opacity: 0;
+}
+.xi-mythic-win .xi-win-gate {
+  position: absolute;
+  left: 50%; top: 30%;
+  width: min(50vw, 220px); height: 8%;
+  transform: translateX(-50%) scaleX(0.2);
+  background: linear-gradient(90deg, transparent, rgba(255, 230, 160, 0.55), transparent);
+  box-shadow: 0 0 40px rgba(255, 200, 100, 0.45);
+  animation: xi-win-gate 1.4s ease-out both;
+  opacity: 0;
+}
+
+#celebration:not(.hidden) .xi-mythic-win .xi-win-cloud,
+#celebration:not(.hidden) .xi-mythic-win .xi-win-lotus,
+#celebration:not(.hidden) .xi-mythic-win .xi-win-array,
+#celebration:not(.hidden) .xi-mythic-win .xi-win-pillars,
+#celebration:not(.hidden) .xi-mythic-win .xi-win-gate {
+  opacity: 1;
+}
+
+#celebration.tier-big .xi-win-cloud,
+#celebration.tier-mega .xi-win-cloud { animation-duration: 1.6s; }
+#celebration.tier-ultra .xi-win-gate,
+#celebration.tier-super .xi-win-gate,
+#celebration.tier-epic .xi-win-gate,
+#celebration.tier-jackpot .xi-win-gate { filter: brightness(1.35); }
+
+@keyframes xi-slot-clouds {
+  0% { transform: translate3d(0, 0, 0); }
+  100% { transform: translate3d(-6%, 0, 0); }
+}
+@keyframes xi-slot-thunder {
+  0%, 88%, 100% { opacity: 0; }
+  90% { opacity: 0.55; }
+  92% { opacity: 0.1; }
+  94% { opacity: 0.4; }
+}
+@keyframes xi-slot-spirit {
+  0% { transform: translate3d(0, 20px, 0); opacity: 0; }
+  20% { opacity: 0.7; }
+  100% { transform: translate3d(8px, -40px, 0); opacity: 0; }
+}
+@keyframes xi-win-cloud {
+  from { transform: translateX(-8%); opacity: 0; }
+  to { transform: translateX(0); opacity: 1; }
+}
+@keyframes xi-win-lotus {
+  from { transform: translate(-50%, -50%) scale(0.4); opacity: 0; }
+  to { transform: translate(-50%, -50%) scale(1); opacity: 0.85; }
+}
+@keyframes xi-win-array {
+  from { transform: translate(-50%, -50%) rotate(-20deg) scale(0.7); opacity: 0; }
+  to { transform: translate(-50%, -50%) rotate(0) scale(1); opacity: 0.55; }
+}
+@keyframes xi-win-pillars {
+  from { opacity: 0; filter: brightness(0.8); }
+  to { opacity: 0.75; filter: brightness(1.15); }
+}
+@keyframes xi-win-gate {
+  from { transform: translateX(-50%) scaleX(0.15); opacity: 0; }
+  to { transform: translateX(-50%) scaleX(1); opacity: 0.9; }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .xi-slot-cloudsea,
+  .xi-slot-thunder,
+  .xi-slot-spirit::before,
+  .xi-slot-spirit::after,
+  .xi-mythic-win span {
+    animation: none !important;
+  }
+}
