+
+.xi-feat-ico {
+  width: 1.55rem;
+  height: 1.55rem;
+  border-radius: 0.45rem;
+  background: linear-gradient(145deg, rgba(232, 197, 106, 0.35), rgba(196, 60, 44, 0.25));
+  border: 1px solid rgba(232, 197, 106, 0.35);
+  position: relative;
+  overflow: hidden;
+}
+
+.xi-feat-ico::before,
+.xi-feat-ico::after {
+  content: "";
+  position: absolute;
+  inset: 18%;
+  opacity: 0.85;
+  pointer-events: none;
+}
+
+/* cloud / lotus / jingubang / jade / palace 鈥?readable silhouettes */
+.xi-feat-ico.motif-cloud {
+  background: linear-gradient(145deg, rgba(180, 210, 230, 0.35), rgba(61, 139, 122, 0.22));
+}
+.xi-feat-ico.motif-cloud::before {
+  inset: 28% 12% 22%;
+  border-radius: 50% 50% 40% 40%;
+  background: rgba(255, 255, 255, 0.55);
+  box-shadow: -6px 2px 0 -1px rgba(255, 255, 255, 0.4), 6px 3px 0 -2px rgba(255, 255, 255, 0.35);
+}
+
+.xi-feat-ico.motif-lotus {
+  background: linear-gradient(145deg, rgba(255, 180, 190, 0.28), rgba(232, 197, 106, 0.28));
+}
+.xi-feat-ico.motif-lotus::before {
+  inset: 22%;
+  background:
+    radial-gradient(circle at 50% 70%, rgba(255, 220, 180, 0.9) 0 28%, transparent 30%),
+    conic-gradient(from 0deg, transparent 0 20deg, rgba(255, 200, 210, 0.75) 20deg 40deg, transparent 40deg 60deg);
+  border-radius: 50%;
+  clip-path: polygon(50% 8%, 62% 38%, 92% 42%, 70% 62%, 78% 92%, 50% 74%, 22% 92%, 30% 62%, 8% 42%, 38% 38%);
+  background: rgba(255, 200, 210, 0.75);
+}
+
+.xi-feat-ico.motif-jingubang {
+  background: linear-gradient(145deg, rgba(232, 197, 106, 0.45), rgba(140, 80, 30, 0.35));
+}
+.xi-feat-ico.motif-jingubang::before {
+  inset: 14% 42%;
+  border-radius: 3px;
+  background: linear-gradient(180deg, #ffe9a8, #b8892d 40%, #ffe9a8 70%, #8a6414);
+  box-shadow: 0 0 0 1px rgba(255, 230, 160, 0.35);
+}
+
+.xi-feat-ico.motif-jade {
+  background: linear-gradient(145deg, rgba(120, 200, 170, 0.4), rgba(40, 90, 80, 0.35));
+}
+.xi-feat-ico.motif-jade::before {
+  inset: 22%;
+  border-radius: 0.35rem;
+  border: 1.5px solid rgba(180, 240, 210, 0.75);
+  background: linear-gradient(145deg, rgba(180, 240, 210, 0.35), transparent 60%);
+  box-shadow: inset 0 0 6px rgba(100, 200, 160, 0.35);
+}
+
+.xi-feat-ico.motif-palace {
+  background: linear-gradient(145deg, rgba(255, 220, 140, 0.4), rgba(90, 50, 30, 0.35));
+}
+.xi-feat-ico.motif-palace::before {
+  inset: 18% 20% 14%;
+  clip-path: polygon(8% 100%, 12% 48%, 28% 48%, 34% 18%, 50% 0, 66% 18%, 72% 48%, 88% 48%, 92% 100%);
+  background: linear-gradient(180deg, rgba(255, 230, 160, 0.9), rgba(180, 120, 40, 0.75));
+}
+
+.xi-bottom-nav {
