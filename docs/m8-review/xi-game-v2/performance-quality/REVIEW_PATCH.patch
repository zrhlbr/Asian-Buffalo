+  image-rendering: auto;
+  -webkit-backface-visibility: hidden;
+  backface-visibility: hidden;
+  transform: translateZ(0);
+  pointer-events: none;
+  z-index: 0;
+}
+
+.xi-bdk-hero-fx {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  z-index: 1;
+}
+
+.xi-bdk-hero-embers {
+  background:
+    radial-gradient(18% 22% at 18% 88%, rgba(255, 120, 40, 0.28), transparent 70%),
+    radial-gradient(22% 28% at 82% 90%, rgba(255, 80, 20, 0.22), transparent 72%);
+  mix-blend-mode: screen;
+  animation: xi-bdk-lava 5s ease-in-out infinite;
+}
+
+.xi-bdk-hero-rays {
+  background:
+    radial-gradient(45% 40% at 55% 20%, rgba(255, 210, 120, 0.18), transparent 70%);
+  mix-blend-mode: screen;
+  opacity: 0.85;
+}
+
+.xi-bdk-hero-copy {
+  position: absolute;
+  left: 0;
+  right: 0;
+  bottom: 0;
+  z-index: 2;
+  pointer-events: none;
+  padding: 2.2rem 0.9rem 0.75rem;
+  background: linear-gradient(180deg, transparent 0%, rgba(8, 4, 4, 0.72) 55%, rgba(8, 4, 4, 0.9) 100%);
+}
+
+.xi-bdk-hero-copy .xi-bdk-tag {
+  margin: 0 0 0.2rem;
+  font-size: 0.72rem;
+  letter-spacing: 0.08em;
+  color: rgba(255, 210, 140, 0.85);
+}
+
+.xi-bdk-hero-copy h1 {
+  margin: 0 0 0.25rem;
+  font-family: var(--xi-font-display);
+  font-size: clamp(1.35rem, 5vw, 1.85rem);
+  color: #ffe7a4;
+  text-shadow: 0 2px 14px rgba(0, 0, 0, 0.65);
+}
+
+.xi-bdk-hero-copy p {
+  margin: 0;
+  font-size: 0.78rem;
+  color: rgba(255, 230, 200, 0.78);
+  line-height: 1.35;
+}
+
+.xi-bdk-hub-photo .xi-bdk-actions {
+  margin-top: 0.15rem;
+}
+
+.xi-bdk-hub-photo .xi-start-game-cta {
+  width: 100%;
+  min-height: 3.1rem;
+  font-size: 1.05rem;
+  letter-spacing: 0.06em;
+}
+
+@media (min-width: 720px) {
+  .xi-bdk-hero-photo {
+    max-height: min(56vh, 32rem);
+  }
+}
+
+@media (max-width: 520px) {
+  .xi-bdk-hero-photo {
+    /* Phone: still contain full plate; taller band if needed */
+    max-height: min(48vh, 22rem);
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .xi-bdk-hero-embers { animation: none; }
+}
+
+/* Fix: hub flex was collapsing hero plate to ~0 width */
+.xi-bdk-hub.xi-bdk-hub-photo {
+  align-items: stretch;
+  justify-content: flex-start;
+  width: 100%;
+  max-width: 720px;
+  margin-inline: auto;
+  padding-top: 0.5rem;
+  padding-bottom: 5rem;
+  text-align: left;
+  background: transparent;
+}
+
+.xi-bdk-hub.xi-bdk-hub-photo .xi-bdk-hero-photo {
+  width: 100%;
+  align-self: stretch;
+  min-height: 14rem;
+}
+
+.xi-bdk-hub.xi-bdk-hub-photo .xi-bdk-actions,
+.xi-bdk-hub.xi-bdk-hub-photo .xi-bdk-feat-section {
+  width: 100%;
+  text-align: center;
+}
+
+.xi-bdk-hub.xi-bdk-hub-photo .xi-section-title {
+  text-align: left;
+}
+
+/* ========== Quality LOD (presentation) 鈥?never touch #hud translateZ elsewhere ========== */
+:root {
+  --xi-transition-ms: 280ms;
+}
+
+.xi-quality-panel {
+  display: flex;
+  flex-direction: column;
+  gap: 0.75rem;
+  margin: 0.75rem 0 1rem;
+  text-align: left;
+}
+.xi-quality-row {
+  display: flex;
+  flex-direction: column;
+  gap: 0.4rem;
+}
+.xi-quality-label {
+  font-size: 0.78rem;
+  letter-spacing: 0.04em;
+  color: rgba(240, 220, 160, 0.85);
+}
+.xi-quality-switch {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 0.35rem;
+}
+
+html[data-xi-tier="low"] .xi-hero-particles span:nth-child(n + 3),
+html[data-xi-tier="low"] .xi-hero-cranes i:nth-child(n + 2) {
+  display: none;
+}
+html[data-xi-tier="low"] .xi-hero-rays,
+html[data-xi-tier="medium"] .xi-hero-rays {
+  opacity: 0.45;
+}
+html[data-xi-tier="low"] .xi-hero-clouds,
+html[data-xi-tier="low"] .xi-hero-mist {
+  animation: none !important;
+  opacity: 0.55;
+}
+html[data-xi-tier="low"] .xi-bdk-hero-embers,
+html[data-xi-tier="low"] .xi-bdk-hero-rays {
+  opacity: 0.25;
+  animation: none !important;
+  filter: none;
+}
+html[data-xi-tier="medium"] .xi-bdk-hero-embers {
+  opacity: 0.55;
+}
+html[data-xi-tier="high"] .xi-bdk-hero-embers,
+html[data-xi-tier="ultra"] .xi-bdk-hero-embers {
+  opacity: 1;
+}
+html[data-xi-fx="off"] .xi-hero-particles,
+html[data-xi-fx="off"] .xi-hero-rays,
+html[data-xi-fx="off"] .xi-bdk-hero-embers,
+html[data-xi-fx="off"] .xi-bdk-hero-rays {
+  display: none !important;
+}
+
+html[data-xi-tier="low"] .xi-layout-v2,
+html[data-xi-tier="low"] .xi-modal,
+html[data-xi-tier="low"] .xi-decree-btn,
+html[data-xi-tier="low"] .xi-primary {
+  transition-duration: var(--xi-transition-ms, 220ms) !important;
+}
