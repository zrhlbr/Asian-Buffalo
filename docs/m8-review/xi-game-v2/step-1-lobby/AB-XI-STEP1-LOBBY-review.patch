+    radial-gradient(14% 65% at 48% 60%, rgba(18, 14, 12, 0.88), transparent 72%),
+    radial-gradient(9% 45% at 68% 74%, rgba(22, 16, 12, 0.75), transparent 70%),
+    radial-gradient(11% 58% at 86% 68%, rgba(16, 12, 10, 0.82), transparent 70%);
+  filter: blur(0.2px);
+}
+
+@media (min-width: 1024px) {
+  .xi-game-grid {
+    grid-template-columns: repeat(4, minmax(0, 1fr));
+  }
+  .xi-hero {
+    min-height: clamp(14rem, 28vw, 20rem);
+  }
+  .xi-main,
+  .xi-hero {
+    max-width: 1100px;
+  }
+  .xi-feat-grid {
+    grid-template-columns: repeat(6, minmax(0, 1fr));
+  }
+}
+
+/* Step 1 next-route stub 鈥?NOT full hub */
+.xi-bdk-stub {
+  display: grid;
+  place-items: center;
+  padding: 1.5rem;
+  background:
+    radial-gradient(70% 50% at 50% 0%, rgba(255, 180, 80, 0.14), transparent 55%),
+    radial-gradient(90% 70% at 50% 100%, rgba(120, 40, 20, 0.22), transparent 60%),
+    linear-gradient(180deg, #141018, #0a0c12 70%);
+}
+
+.xi-bdk-stub-card {
+  width: min(100%, 26rem);
+  text-align: center;
+  padding: 1.6rem 1.25rem 1.4rem;
+  border-radius: 1rem;
+  border: 1px solid rgba(232, 197, 106, 0.4);
+  background: rgba(12, 14, 20, 0.78);
+  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
+}
+
+.xi-bdk-stub-card h1 {
+  margin: 0.35rem 0 0.75rem;
+  font-family: var(--xi-font-display);
+  font-size: clamp(1.45rem, 5vw, 1.9rem);
+  color: #ffe7a4;
+}
+
+.xi-bdk-stub-tag {
+  margin: 0;
+  font-size: 0.78rem;
+  letter-spacing: 0.08em;
+  color: rgba(200, 220, 255, 0.75);
+}
+
+.xi-bdk-stub-card p {
+  margin: 0 0 1.1rem;
+  color: rgba(244, 231, 194, 0.78);
+  line-height: 1.45;
+  font-size: 0.92rem;
+}
+
+.xi-bdk-stub-back {
+  display: inline-flex !important;
+  min-width: 12rem;
+  text-decoration: none;
+}
