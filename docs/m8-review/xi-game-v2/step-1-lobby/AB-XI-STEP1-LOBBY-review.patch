+"use client";
+
+import Link from "next/link";
+import { useEffect, useSyncExternalStore } from "react";
+import {
+  getLobbyLangServerSnapshot,
+  loadLobbyLang,
+  subscribeLobbyLang,
+  tLobby,
+} from "./i18n.ts";
+import "./lobby.css";
+
+/**
+ * Step 1 ONLY 鈥?minimal next-layer route stub.
+ * Full hub / play UI is deferred until Zhao acceptance of `/xi`.
+ */
+export default function BdkHubStub() {
+  const lang = useSyncExternalStore(
+    subscribeLobbyLang,
+    loadLobbyLang,
+    getLobbyLangServerSnapshot,
+  );
+  const t = (key: string) => tLobby(lang, key);
+
+  useEffect(() => {
+    document.title = tLobby(lang, "lobby.page.bdkHub");
+  }, [lang]);
+
+  return (
+    <div
+      className="xi-lobby-root xi-bdk-stub"
+      data-testid="xi-bdk-stub"
+      lang={lang}
+      data-lang={lang}
+    >
+      <div className="xi-bdk-stub-card">
+        <p className="xi-bdk-stub-tag">{t("lobby.brand")}</p>
+        <h1 data-testid="xi-hub-title">{t("lobby.page.bdkHub")}</h1>
+        <p data-testid="xi-stub-note">{t("lobby.stub.afterAccept")}</p>
+        <Link
+          className="xi-primary xi-bdk-stub-back"
+          href="/xi"
+          data-testid="xi-hub-back-lobby"
+        >
+          鈫?{t("lobby.bdk.backXi")}
+        </Link>
+      </div>
+    </div>
+  );
+}
